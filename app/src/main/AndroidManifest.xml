<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      PRIVACY CONTRACT: Mind Palace is fully offline by design (docs/DECISIONS.md D4).
      This manifest must never declare android.permission.INTERNET or any network access.
      PrivacyManifestTest fails the build if INTERNET ever appears here.
      Adding ANY permission requires the owner's explicit sign-off.
    -->

    <application
        android:name=".MindPalaceApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MindPalace">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 1 backend: share text/links into the Inbox. No UI; saves then finishes. -->
        <activity
            android:name=".capture.ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target_name"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
