<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      PRIVACY CONTRACT: Mind Palace is fully offline by design (docs/DECISIONS.md D4).
      This manifest must never declare android.permission.INTERNET or any network access.
      PrivacyManifestTest fails the build if INTERNET ever appears here.
      Adding ANY permission requires the owner's explicit sign-off.
    -->

    <!-- Sign-off: 2026-11-09 (docs/PERMISSIONS.md, docs/DECISIONS.md D15). Mic audio only, for
         on-device SpeechRecognizer; no audio is ever written to disk. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- com.google.mlkit:text-recognition's transitive Play-Services-base manifest declares
         these defensively, unconditionally, even for the fully-bundled/on-device model this app
         uses (docs/DECISIONS.md D17). OCR never makes a network call, so they're stripped here
         rather than silently accepted — PrivacyManifestTest would otherwise fail the build. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Photo capture uses the SYSTEM camera app via an implicit intent (no CAMERA permission
         of our own); declared optional so devices without a camera can still install. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".MindPalaceApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MindPalace">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 1 backend: share text/links into the Inbox. No UI; saves then finishes. -->
        <activity
            android:name=".capture.ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target_name"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Lets the share sheet read an export file from our private dir; no permission
             granted beyond that one file, and only while a share is in progress. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
